# Copy this file to .env and fill in real values. Never commit the real .env file.

# API-Football key — sign up free at https://dashboard.api-football.com
# (also usable via RapidAPI if you'd rather manage keys there instead)
SPORTS_API_KEY=your_api_key_here

# Pick any private string — used to view /analytics/summary?key=...
ANALYTICS_KEY=change_this_to_something_only_you_know

PORT=3000
